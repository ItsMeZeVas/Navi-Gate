# Copia este archivo como backend/.env y ajusta los valores.
# (backend/.env está en .gitignore: nunca se sube a GitHub)

# --- Desarrollo local (docker compose) ---
DATABASE_URL="postgresql://postgres:postgres@db:5432/navigate?schema=public"
PORT=3000
JWT_SECRET="cambia-este-secreto-antes-de-produccion"

# --- Solo producción (se configuran en el panel de Render, no en este archivo) ---
# DIRECT_URL        Conexión directa a Neon (sin pooler); la usan las migraciones.
# FRONTEND_URL      URL de tu sitio en Vercel, sin "/" al final. Varias, separadas por coma.
# CLOUDINARY_URL    cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (fotos en producción)
