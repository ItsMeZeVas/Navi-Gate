// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// Navi-Gate — modelo de datos
// ---------------------------------------------------------

// Tipos de espacio dentro de un bloque. Se puede ampliar sin
// tocar la estructura de tablas (solo agregar un valor aquí).
enum TipoEspacio {
  SALON
  OFICINA
  LABORATORIO
  CAFETERIA
  BANO
  OTRO
}

// Administrador del panel. Se crea manualmente (seed / consola),
// no hay endpoint de registro público.
model Admin {
  id           Int      @id @default(autoincrement())
  usuario      String   @unique
  passwordHash String
  creadoEn     DateTime @default(now())

  @@map("admins")
}

// Punto físico donde está pegado un código QR.
// El "slug" es el identificador que va en la URL del QR
// (ej. /qr/entrada-principal) y es lo que el sistema usa
// para saber el punto de origen sin preguntarle nada al usuario.
model Qr {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nombre    String // ej. "Entrada Principal"
  creadoEn  DateTime @default(now())

  rutas Ruta[]
  escaneos Escaneo[]

  @@map("qrs")
}

// Un bloque/edificio/zona del campus. Agrupa uno o varios espacios
// (salones, oficinas, laboratorios, cafeterías, baños, etc).
model Bloque {
  id       Int      @id @default(autoincrement())
  nombre   String // ej. "Bloque C"
  creadoEn DateTime @default(now())

  espacios Espacio[]
  rutas    Ruta[]

  @@map("bloques")
}

// Ruta manual: instrucciones de texto para llegar desde un QR
// (origen) hasta un Bloque (destino). Cada combinación QR-Bloque
// debe tener como máximo una ruta cargada.
model Ruta {
  id            Int      @id @default(autoincrement())
  qrId          Int
  bloqueId      Int
  instrucciones String[] // lista de pasos, ej. ["Camina hacia el Bloque C.", "Sube al segundo piso."]
  fotos         String[] @default([]) // URLs de fotos de referencia del recorrido (opcional)

  qr     Qr     @relation(fields: [qrId], references: [id], onDelete: Cascade)
  bloque Bloque @relation(fields: [bloqueId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([qrId, bloqueId]) // una sola ruta por combinación origen-destino
  @@map("rutas")
}

// Espacio dentro de un bloque: salón, oficina, laboratorio, cafetería, baño, etc.
// El "nombre" es lo único editable por el admin (renombrar), y renombrarlo
// no afecta ni la ruta del bloque ni la instrucción final.
model Espacio {
  id                Int         @id @default(autoincrement())
  nombre            String // ej. "C307" — editable por el admin
  tipo              TipoEspacio
  piso              Int // ej. 3 — permite filtrar espacios por piso dentro de un bloque
  bloqueId          Int
  instruccionFinal  String // ej. "Segundo piso, tercera puerta a la derecha"
  fotos             String[]    @default([]) // URLs de fotos de referencia del espacio (opcional)
  creadoEn          DateTime    @default(now())
  actualizadoEn     DateTime    @updatedAt

  bloque Bloque @relation(fields: [bloqueId], references: [id], onDelete: Cascade)

  @@index([bloqueId, piso])
  @@map("espacios")
}

// Registro de cada vez que alguien escanea un QR (para estadísticas futuras).
model Escaneo {
  id          Int      @id @default(autoincrement())
  qrId        Int
  escaneadoEn DateTime @default(now())

  qr Qr @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId])
  @@map("escaneos")
}
