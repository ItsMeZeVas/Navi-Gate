// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// Navi-Gate — modelo de datos
// ---------------------------------------------------------

// Tipos de espacio dentro de un bloque. Se puede ampliar sin
// tocar la estructura de tablas (solo agregar un valor aquí).
enum TipoEspacio {
  SALON
  OFICINA
  LABORATORIO
  CAFETERIA
  BANO
  OTRO
}

// Tipos de nodo dentro del grafo de mapeo. QR, BLOQUE y ESPACIO
// representan entidades que ya existen en el modelo (un nodo "ligado");
// los demás son puntos intermedios que solo existen dentro del grafo,
// para describir el recorrido físico real entre un QR y un destino.
enum TipoNodoGrafo {
  QR
  BLOQUE
  ESPACIO
  PASILLO
  ESCALERA
  ASCENSOR
  PUERTA
  PUNTO_REFERENCIA
}

// Administrador del panel. Se crea manualmente (seed / consola),
// no hay endpoint de registro público.
model Admin {
  id           Int      @id @default(autoincrement())
  usuario      String   @unique
  passwordHash String
  creadoEn     DateTime @default(now())

  @@map("admins")
}

// Punto físico donde está pegado un código QR.
// El "slug" es el identificador que va en la URL del QR
// (ej. /qr/entrada-principal) y es lo que el sistema usa
// para saber el punto de origen sin preguntarle nada al usuario.
model Qr {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nombre    String // ej. "Entrada Principal"
  creadoEn  DateTime @default(now())

  rutas Ruta[]
  escaneos Escaneo[]

  // Nodo del grafo de mapeo ligado a este QR (1 a 1, opcional: solo
  // existe una vez que el admin abrió la vista de grafo al menos una vez).
  nodoGrafo NodoGrafo?

  @@map("qrs")
}

// Un bloque/edificio/zona del campus. Agrupa uno o varios espacios
// (salones, oficinas, laboratorios, cafeterías, baños, etc).
model Bloque {
  id       Int      @id @default(autoincrement())
  nombre   String // ej. "Bloque C"
  creadoEn DateTime @default(now())

  espacios Espacio[]
  rutas    Ruta[]

  // Nodo del grafo de mapeo ligado a este Bloque (ver Qr.nodoGrafo).
  nodoGrafo NodoGrafo?

  @@map("bloques")
}

// Ruta: instrucciones de texto para llegar desde un QR (origen) hasta
// un Bloque O un Espacio (destino) — nunca ambos a la vez. La mayoría
// son manuales (bloqueId), tal como funcionaba desde el inicio; el
// grafo de mapeo puede generar además rutas más específicas apuntando
// directo a un Espacio, sin afectar las que ya apuntan a un Bloque.
// Cada combinación QR-Bloque y QR-Espacio admite como máximo una ruta.
model Ruta {
  id            Int      @id @default(autoincrement())
  qrId          Int
  bloqueId      Int? // destino a nivel bloque (flujo original)
  espacioId     Int? // destino a nivel espacio puntual (generado desde el grafo)
  nodoGrafoId   Int? // destino a un punto del grafo (punto de referencia, ascensor, escalera…)
  instrucciones String[] // lista de pasos, ej. ["Camina hacia el Bloque C.", "Sube al segundo piso."]
  fotos         String[] @default([]) // URLs de fotos de referencia del recorrido (opcional)

  qr      Qr      @relation(fields: [qrId], references: [id], onDelete: Cascade)
  bloque  Bloque? @relation(fields: [bloqueId], references: [id], onDelete: Cascade)
  espacio Espacio? @relation(fields: [espacioId], references: [id], onDelete: Cascade)
  // Si se elimina el punto del grafo, la ruta que llegaba a él se elimina también.
  nodoGrafo NodoGrafo? @relation(fields: [nodoGrafoId], references: [id], onDelete: Cascade)

  // Snapshot de los ids de nodos/edges del grafo usados para generar esta
  // ruta (vacío si se creó a mano). Sirve solo para detectar, en el panel
  // admin, si el grafo cambió después y la ruta quedó desactualizada.
  nodosGrafoUsados Int[]   @default([])
  edgesGrafoUsados Int[]   @default([])
  desactualizada   Boolean @default(false)

  // Marca si ya se reflejó (una sola vez) como conexión Qr→Bloque en el
  // grafo de mapeo. Es de una sola vía: una vez en true, el grafo nunca
  // vuelve a recrear esa conexión aunque el admin la haya borrado a mano.
  edgeGrafoSincronizado Boolean @default(false)

  creadoEn DateTime @default(now())

  @@unique([qrId, bloqueId]) // una sola ruta por combinación QR-Bloque
  @@unique([qrId, espacioId]) // una sola ruta por combinación QR-Espacio
  @@unique([qrId, nodoGrafoId]) // una sola ruta por combinación QR-punto del grafo
  @@map("rutas")
}

// Espacio dentro de un bloque: salón, oficina, laboratorio, cafetería, baño, etc.
// El "nombre" es lo único editable por el admin (renombrar), y renombrarlo
// no afecta ni la ruta del bloque ni la instrucción final.
model Espacio {
  id                Int         @id @default(autoincrement())
  nombre            String // ej. "C307" — editable por el admin
  tipo              TipoEspacio
  piso              Int // ej. 3 — permite filtrar espacios por piso dentro de un bloque
  bloqueId          Int
  instruccionFinal  String // ej. "Segundo piso, tercera puerta a la derecha"
  fotos             String[]    @default([]) // URLs de fotos de referencia del espacio (opcional)
  creadoEn          DateTime    @default(now())
  actualizadoEn     DateTime    @updatedAt

  bloque Bloque @relation(fields: [bloqueId], references: [id], onDelete: Cascade)

  // Rutas generadas (normalmente desde el grafo) que apuntan directo a
  // este espacio en vez de a su bloque. Ver Ruta.espacioId.
  rutas Ruta[]

  // Nodo del grafo de mapeo ligado a este Espacio (ver Qr.nodoGrafo).
  nodoGrafo NodoGrafo?

  // Igual que Ruta.edgeGrafoSincronizado, pero para la conexión implícita
  // Espacio→Bloque (por pertenencia). Una sola vía: no se vuelve a crear
  // sola si el admin la borra del grafo.
  edgeGrafoSincronizado Boolean @default(false)

  // Sub-eventos que se realizan en este espacio (ver SubEvento).
  subEventos SubEvento[]

  @@index([bloqueId, piso])
  @@map("espacios")
}

// Registro de cada vez que alguien escanea un QR (para estadísticas futuras).
model Escaneo {
  id          Int      @id @default(autoincrement())
  qrId        Int
  escaneadoEn DateTime @default(now())

  qr Qr @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@index([qrId])
  @@map("escaneos")
}

// ---------------------------------------------------------
// Grafo de mapeo — funcionalidad opcional del panel admin para
// generar rutas automáticamente en vez de escribirlas a mano.
// No reemplaza nada del modelo anterior: Qr, Bloque, Espacio y Ruta
// siguen funcionando exactamente igual si nunca se usa el grafo.
// ---------------------------------------------------------

// Un nodo del grafo. Puede estar "ligado" a un Qr, Bloque o Espacio
// ya existente (para que el grafo sepa cómo conectarlos), o ser un
// punto intermedio puro (pasillo, escalera, ascensor, puerta, punto
// de referencia) que solo existe para describir el recorrido físico.
model NodoGrafo {
  id       Int           @id @default(autoincrement())
  tipo     TipoNodoGrafo
  etiqueta String? // nombre del nodo; solo se usa para nodos intermedios.
  // Para nodos ligados (QR/BLOQUE/ESPACIO) el nombre mostrado siempre
  // se toma en vivo de la entidad relacionada, para no duplicar datos.

  posX Float @default(0) // posición en el lienzo del panel admin
  posY Float @default(0)

  piso      Int? // piso donde está el nodo (null si no aplica)
  pisoHasta Int? // solo para ESCALERA/ASCENSOR: piso al que se llega desde "piso"

  // Solo para nodos intermedios: si es true, se puede buscar en la app
  // pública y el generador de rutas masivo crea rutas hacia él.
  visibleEnApp Boolean @default(false)

  qrId      Int? @unique
  bloqueId  Int? @unique
  espacioId Int? @unique

  qr      Qr?      @relation(fields: [qrId], references: [id], onDelete: Cascade)
  bloque  Bloque?  @relation(fields: [bloqueId], references: [id], onDelete: Cascade)
  espacio Espacio? @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  edgesDesde EdgeGrafo[] @relation("EdgeOrigen")
  edgesHacia EdgeGrafo[] @relation("EdgeDestino")

  // Rutas cuyo destino es este punto.
  rutasDestino Ruta[]

  creadoEn DateTime @default(now())

  @@map("nodos_grafo")
}

// Conexión (tramo caminable) entre dos nodos del grafo. Se trata como
// bidireccional al calcular rutas (un pasillo se puede caminar en los
// dos sentidos), aunque queda guardado un origen y un destino fijos.
model EdgeGrafo {
  id        Int @id @default(autoincrement())
  origenId  Int
  destinoId Int

  origen  NodoGrafo @relation("EdgeOrigen", fields: [origenId], references: [id], onDelete: Cascade)
  destino NodoGrafo @relation("EdgeDestino", fields: [destinoId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([origenId, destinoId])
  @@map("edges_grafo")
}

// ---------------------------------------------------------
// Eventos — anuncios administrables desde el panel (ej. "Día de la
// Ingeniería Multimedia"). Se muestran en una burbuja en la pantalla
// de Inicio de la app pública, solo mientras el evento está en curso.
// Es independiente del resto del modelo: no afecta QRs, rutas ni grafo.
// ---------------------------------------------------------

model Evento {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String   @default("")
  imagen      String? // URL de la imagen (opcional)
  inicio      DateTime
  fin         DateTime
  visible     Boolean  @default(true) // interruptor manual para ocultarlo
  creadoEn    DateTime @default(now())

  subEventos SubEvento[]

  @@index([inicio, fin])
  @@map("eventos")
}

// Una actividad dentro de un Evento, con su propio horario y su lugar
// (un Espacio ya registrado, así "Cómo llegar" usa las rutas existentes).
// Si el Espacio se elimina, el sub-evento se conserva pero queda sin lugar.
model SubEvento {
  id          Int      @id @default(autoincrement())
  eventoId    Int
  espacioId   Int?
  nombre      String
  descripcion String   @default("")
  imagen      String?
  inicio      DateTime
  fin         DateTime
  visible     Boolean  @default(true)
  creadoEn    DateTime @default(now())

  evento  Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  espacio Espacio? @relation(fields: [espacioId], references: [id], onDelete: SetNull)

  @@index([eventoId])
  @@map("sub_eventos")
}
